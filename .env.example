# Application
GOLFARO_APP_ENV=production
GOLFARO_DEBUG=false
GOLFARO_APP_VERSION=0.1.0
GOLFARO_ALLOWED_HOSTS=golfaro.bouchard-mehdi.fr,localhost,127.0.0.1
GOLFARO_CORS_ORIGINS=https://golfaro.bouchard-mehdi.fr

# Host ports used by Nginx
FRONTEND_PORT=8088
BACKEND_PORT=3008

# PostgreSQL
POSTGRES_DB=golfaro
POSTGRES_USER=golfaro
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public URLs embedded in the frontend build
NEXT_PUBLIC_APP_URL=https://golfaro.bouchard-mehdi.fr
NEXT_PUBLIC_API_URL=/api/v1
